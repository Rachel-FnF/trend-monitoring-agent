# ============================================================
# 트렌드 모니터링 Agent — 환경변수 양식
# 이 파일을 복사해서 같은 폴더에 `.env` 로 저장하고 값을 채우세요.
#   copy .env.example .env
# `.env` 는 .gitignore 되어 있어 git에 올라가지 않습니다.
# ============================================================

# --- 캐릿 로그인 (필수) -------------------------------------
# 캐릿(careet.net) 유료 계정. 수집 단계(collect.py)와
# 최초 프로필 설정(setup_profile.py)에서 사용.
# 인수인계 시: 전임자 계정을 물려받지 말고, 새 담당자 명의로
# 새 계정 가입 + 유료 멤버십 결제 후 그 값을 입력하세요.
# ⚠️ 캐릿은 기기 4개 제한 + 신규 기기 이메일 OTP 인증이 있음.
CAREET_EMAIL=
CAREET_PASSWORD=

# --- Gemini API (필수) --------------------------------------
# 본문+이미지 종합 분석(content_analyzer.py)에 사용.
# Google AI Studio(https://aistudio.google.com)에서 발급.
GEMINI_API_KEY=

# --- 구글 시트 push (필수) ----------------------------------
# 구글 서비스계정 JSON 키 파일 경로. 생략 시 기본값 gcp_sa.json
# (프로젝트 루트에 두고, 시트를 서비스계정 이메일에 '편집자'로 공유할 것.
#  키 파일은 git에 올리지 말고 DM으로만 전달받기.)
GOOGLE_SA_KEY=gcp_sa.json

# 결과를 누적할 구글 시트의 스프레드시트 ID
# (시트 URL의 /d/ 와 /edit 사이 문자열)
# 인수인계는 '소유권 이전' 방식이라 시트 주소가 바뀌지 않음 → 아래 값 그대로 사용
SHEETS_TREND_ID=1w7qX0tpfOI8FbNUDs740tQ7uobGIhuol46WflZc8ENk

# 시트 탭 이름. 생략 시 기본값 trends
SHEETS_TAB=trends

# --- 선택 옵션 ----------------------------------------------
# 수집 컷오프 날짜 임시 override (기본: 오늘-21일). 형식 YYYY-MM-DD
# 평소에는 비워두거나 지워두세요.
# SINCE_DATE=
